{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "disposable-check-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "DOMAINS_BUCKET",
			"bucket_name": "disposable-domains"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_KEY_MANAGER",
				"class_name": "ApiKeyManager"
			},
			{
				"name": "CONTAINER_WORKER",
				"class_name": "ReacherWorker"
			}
		]
	},
	"containers": [
		{
			"class_name": "ReacherWorker",
			"image": "./container/Dockerfile"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"ApiKeyManager"
			]
		},
		{
			"tag": "v2",
			"new_classes": [
				"ContainerWorker"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"ReacherWorker"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 4 * * *"
		]
	},
	"env": {
		"staging": {
			"name": "disposable-check-api-staging",
			"r2_buckets": [
				{
					"binding": "DOMAINS_BUCKET",
					"bucket_name": "disposable-domains-staging"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "API_KEY_MANAGER",
						"class_name": "ApiKeyManagerStaging"
					},
					{
						"name": "CONTAINER_WORKER", // Reuse same class for staging/prod logic if needed, or subclass
						"class_name": "ReacherWorker"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"ApiKeyManagerStaging"
					]
				},
				{
					"tag": "v2",
					"new_classes": [
						"ContainerWorker"
					]
				},
				{
					"tag": "v3",
					"new_sqlite_classes": [
						"ReacherWorker"
					]
				}
			],
			"containers": [
				{
					"class_name": "ReacherWorker",
					"image": "./container/Dockerfile"
				}
			]
		},
		"production": {
			"name": "disposable-check-api",
			"r2_buckets": [
				{
					"binding": "DOMAINS_BUCKET",
					"bucket_name": "disposable-domains"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "API_KEY_MANAGER",
						"class_name": "ApiKeyManagerProduction"
					},
					{
						"name": "CONTAINER_WORKER",
						"class_name": "ReacherWorker"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"ApiKeyManagerProduction"
					]
				},
				{
					"tag": "v2",
					"new_classes": [
						"ContainerWorker"
					]
				},
				{
					"tag": "v3",
					"new_sqlite_classes": [
						"ReacherWorker"
					]
				}
			],
			"routes": [
				{
					"pattern": "disposablecheck.irensaltali.com/api/*",
					"zone_name": "irensaltali.com"
				}
			],
			"containers": [
				{
					"class_name": "ReacherWorker",
					"image": "./container/Dockerfile"
				}
			]
		}
	}
}